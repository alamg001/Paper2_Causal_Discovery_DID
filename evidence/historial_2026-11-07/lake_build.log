info: Audit.lean:26:0: ConjeturaLeanXYZ.finite_conditional_CATT_bias.{u_1} {W : Type u_1} [Fintype W] (law : FiniteLaw W) (s : Finset W)
  (p phat mu1 mu0 m : W → ℝ) (_hprob : ∀ (w : W), 0 ≤ p w ∧ p w ≤ 1) (hden : ∀ w ∈ s, 1 - phat w ≠ 0)
  (_hpositive : 0 < cellTreatedMass s law.mass p) :
  (∑ w ∈ s, law.mass w * signalMean (p w) (phat w) (mu1 w) (mu0 w) (m w)) / cellTreatedMass s law.mass p =
    cellCATT s law.mass p mu1 mu0 +
      (∑ w ∈ s, law.mass w * nuisanceProduct (p w) (phat w) (mu0 w) (m w)) / cellTreatedMass s law.mass p
info: Audit.lean:27:0: ConjeturaLeanXYZ.finite_true_excess.{u_1} {W : Type u_1} [Fintype W] (law : FiniteLaw W) (p mu1 mu0 theta : W → ℝ)
  (_hprob : ∀ (w : W), 0 ≤ p w ∧ p w ≤ 1) (hden : ∀ (w : W), 1 - p w ≠ 0)
  (_hrho : 0 < cellTreatedMass Finset.univ law.mass p) :
  (finiteRiskNumerator Finset.univ law.mass p (fun w => signalMean (p w) (p w) (mu1 w) (mu0 w) (mu0 w)) theta -
        finiteRiskNumerator Finset.univ law.mass p (fun w => signalMean (p w) (p w) (mu1 w) (mu0 w) (mu0 w)) fun w =>
          mu1 w - mu0 w) /
      cellTreatedMass Finset.univ law.mass p =
    (∑ w, law.mass w * p w * (theta w - (mu1 w - mu0 w)) ^ 2) / cellTreatedMass Finset.univ law.mass p
