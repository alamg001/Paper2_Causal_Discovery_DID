info: Audit.lean:43:0: theorem Paper2.finite_orthogonal_product_bound.{u_1} : ∀ {W : Type u_1} [inst : Fintype W] (law : Paper2.Law W)
  (p phat mu1 mu0 m theta : W → ℝ) (c eps : ℝ),
  0 < c →
    (∀ (w : W), c ≤ p w ∧ p w ≤ 1 - c) →
      (∀ (w : W), c ≤ phat w ∧ phat w ≤ 1 - c) →
        0 < ∑ w, law.mass w * p w →
          (Paper2.risk law.mass p (fun w => Paper2.signal (p w) (phat w) (mu1 w) (mu0 w) (m w)) theta -
                  Paper2.risk law.mass p (fun w => Paper2.signal (p w) (phat w) (mu1 w) (mu0 w) (m w)) fun w =>
                    mu1 w - mu0 w) /
                ∑ w, law.mass w * p w ≤
              eps →
            (∑ w, law.mass w * p w * (theta w - (mu1 w - mu0 w)) ^ 2) / ∑ w, law.mass w * p w ≤
              2 * eps +
                4 / ((∑ w, law.mass w * p w) * c ^ 3) *
                  (√(∑ w, law.mass w * (m w - mu0 w) ^ 4) * √(∑ w, law.mass w * (phat w - p w) ^ 4)) :=
